From: lurcher <nick@lurcher.org>
Date: Tue, 19 May 2026 14:09:58 +0100
Subject: [PATCH] Fix buffer overflow in SQLGetInfoW #235

---
 DriverManager/SQLGetInfoW.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/DriverManager/SQLGetInfoW.c b/DriverManager/SQLGetInfoW.c
index fab9ca4..8dc1887 100644
--- a/DriverManager/SQLGetInfoW.c
+++ b/DriverManager/SQLGetInfoW.c
@@ -444,6 +444,7 @@ SQLRETURN SQLGetInfoW( SQLHDBC connection_handle,
               case SQL_OUTER_JOINS:
                 if ( SQL_SUCCEEDED( ret ) && info_value && buffer_length > 0 )
                 {
+                    buffer_length = buffer_length / sizeof( SQLWCHAR );
                     as1 = malloc( buffer_length + 1 );
                 }
                 break;
